#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
/bin/sh "$script_dir/preinstall-legacy"
if /usr/bin/pgrep -f '/probe_native_service_once.py' >/dev/null; then
    echo 'O teste nativo ainda está em andamento. Aguarde terminar antes de instalar.' >&2
    exit 1
fi
if [ -e '/Library/Application Support/AIC88M80Driver/native-release.json' ]; then
    /usr/bin/python3 - <<'PY' || {
import json
from pathlib import Path
record = json.loads(Path('/Library/Application Support/AIC88M80Driver/native-release.json').read_text())
assert record.get('version') in ('0.0.15', '0.0.16', '0.0.17', '0.0.18', '0.0.19', '0.0.20', '0.0.21', '0.0.22', '0.0.23', '0.0.24'), 'Versão nativa existente inesperada'
PY
        echo 'A instalação nativa existente não corresponde a esta atualização.' >&2
        exit 1
    }
fi
